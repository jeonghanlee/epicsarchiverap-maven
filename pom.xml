    <default.sitespecific.path>${project.basedir}/src/sitespecific/${archapplsite}</default.sitespecific.path>
    <sitespecific.path>${default.sitespecific.path}</sitespecific.path>
    <tomcat.home>${env.TOMCAT_HOME}</tomcat.home>
    <junit.jupiter.version>5.9.3</junit.jupiter.version>
    <log4j.version>2.26.1</log4j.version>
    <commons-io.version>2.22.0</commons-io.version>
    <commons-lang3.version>3.20.0</commons-lang3.version>
  </properties>
  <repositories>
    <repository>
      <id>project-local</id>
      <url>file://${project.basedir}/lib/repo</url>
    </repository>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>clojars</id>
      <url>https://clojars.org/repo</url>
    </repository>
  </repositories>
  <dependencyManagement>
    <dependencies>
      <!-- Shared versions apply to every path, including test-only dependency graphs. -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.7.1-jre</version>
      </dependency>
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
