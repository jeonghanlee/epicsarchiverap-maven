    field(SCAN, "10 second")
    field(CALC, "0")
    field(EGU, "V")
    field(PREC, "3")
    field(DESC, "10 + 2 sin, period 3600 s, every minute")
}
record(waveform, "SR:GEN:WAVE") {
    field(FTVL, "DOUBLE")
    field(NELM, "2048")
    field(EGU, "V")
    field(PREC, "3")
    field(DESC, "sine, three peaks and a background")
}
record(waveform, "SR:GEN:WAVE:X") {
    field(FTVL, "DOUBLE")
    field(NELM, "2048")
    field(EGU, "mm")
    field(PREC, "3")
    field(DESC, "axis of SR:GEN:WAVE")
}
record(ao, "SR:GEN:WAVE:FS") {
    field(VAL, "2048")
    field(EGU, "Hz")
    field(PREC, "1")
    field(DESC, "sampling frequency within SR:GEN:WAVE")
}
record(waveform, "SR:GEN:IMAGE") {
    field(FTVL, "USHORT")
    field(NELM, "307200")
    field(EGU, "count")
    field(DESC, "640 by 480 image with a Gaussian blob")
}
record(ao, "SR:GEN:IMAGE:W") {
    field(VAL, "640")
    field(PREC, "0")
    field(DESC, "width of SR:GEN:IMAGE")
}
record(ao, "SR:GEN:IMAGE:H") {
    field(VAL, "480")
