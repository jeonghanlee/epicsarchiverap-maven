# Soft IOC database for the checks of the Analyzer tools: records whose history is generated.
# The live value of each record is a constant, so that the appliance can archive the name and read its unit, precision and limits;
# the history that the checks use is written into the store of the appliance by AnalyzerFixtureData of src/test (a normal sample,
# a sine of a known period, a pattern over days, and the signals of known relationship of the tools of two and several signals)
# and is not what these records produce.
#   SR:GEN:NORMAL   V   normal sample of mean 10 and standard deviation 2; limits at 2 and 3 standard deviations
#   SR:GEN:SINE     V   1.5 times the sine of a period of 600 s; limits at 1.0 and 1.4
#   SR:GEN:PATTERN  kW  20 plus a daily cosine that peaks at 14:00 UTC, minus 4 on Saturday and Sunday, with noise of 0.2
#   SR:GEN:BASIS:01 to :16  mm  sixteen independent sines of distinct periods with noise, the basis of the dependency checks
#   SR:GEN:TARGET   mm  2 times basis 1 minus 1.5 times basis 2 plus 0.5 times basis 3, plus 5, with noise of 0.3
#   SR:GEN:CORR:A, SR:GEN:CORR:B  V  a pair of normal signals of correlation 0.8
#   SR:GEN:SLOW     V   10 plus 2 times the sine of a period of 3600 s, one value a minute, for the pairing of different rates
#   SR:GEN:WAVE     V   2048-element waveform of doubles: a sine of known frequency, three Gaussian peaks and a slow background
#   SR:GEN:WAVE:X   mm  the axis of that waveform (element n holds 0.5 n mm in the first half of the hour and 100 + 0.25 n mm
#                       in the second), a companion PV of the axis role
#   SR:GEN:WAVE:FS  Hz  the sampling frequency within the waveform, a companion PV of the frequency role
#   SR:GEN:IMAGE    count  640 by 480 pixels of unsigned 16-bit values (307200 elements): a Gaussian blob of known centre and width
#   SR:GEN:IMAGE:W, SR:GEN:IMAGE:H  the width and the height of that image, companion PVs of the size roles
#   SR:GEN:FRAME    count  1920 by 1200 unsigned 16-bit pixels (2304000 elements), for the measurement of the size of a camera frame
# Load it beside ConsoleChartPVs.db (its st.cmd loads that file); the checks of the Analyzer start one IOC with both.

record(calc, "SR:GEN:NORMAL") {
    field(SCAN, "10 second")
    field(CALC, "0")
    field(EGU, "V")
    field(PREC, "3")
    field(LOPR, "0")
    field(HOPR, "20")
    field(LOLO, "4")
    field(LLSV, "MAJOR")
    field(LOW, "6")
    field(LSV, "MINOR")
    field(HIGH, "14")
    field(HSV, "MINOR")
    field(HIHI, "16")
    field(HHSV, "MAJOR")
    field(DESC, "normal sample, mean 10, sd 2")
}
record(calc, "SR:GEN:SINE") {
    field(SCAN, "10 second")
    field(CALC, "0")
    field(EGU, "V")
    field(PREC, "3")
    field(LOPR, "-2")
    field(HOPR, "2")
    field(LOW, "-1")
    field(LSV, "MINOR")
    field(HIGH, "1")
    field(HSV, "MINOR")
    field(DESC, "sine, period 600 s, amplitude 1.5")
}
record(calc, "SR:GEN:PATTERN") {
    field(SCAN, "10 second")
    field(CALC, "0")
    field(EGU, "kW")
    field(PREC, "3")
    field(LOPR, "10")
    field(HOPR, "30")
    field(DESC, "daily and weekly pattern")
}
record(calc, "SR:GEN:BASIS:01") {
    field(SCAN, "10 second")
    field(CALC, "0")
    field(EGU, "mm")
    field(PREC, "3")
    field(DESC, "basis 1, period 1200 s")
}
