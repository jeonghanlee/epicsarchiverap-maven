<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="Retrieval interrupt diagnostics" description="Actual request exception stacks" provider="Archiver Appliance">
  <event name="jdk.JavaExceptionThrow">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">true</setting>
  </event>
</configuration>
